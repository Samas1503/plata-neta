# App
DATABASE_URL=postgresql://plata:plata@localhost:5433/plata_neta
APP_ENV=sandbox                          # sandbox | production

# Auth (apps/web)
AUTH_SECRET=                             # openssl rand -base64 32
AUTH_URL=http://localhost:3500

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# MODO / Ualá / Naranja X
MODO_API_KEY=
UALA_API_KEY=
NARANJAX_API_KEY=

# Ripio — scoped keys only: create-intent + read-status, NEVER movement endpoints (RULES.MD §8)
RIPIO_API_KEY=
RIPIO_API_SECRET=
RIPIO_WEBHOOK_SECRET=

# Suscripciones
BILLING_CRON_SECRET=

# Crypto para PspCredential (AES-256-GCM, 32 bytes base64)
ENCRYPTION_KEY=                        # openssl rand -base64 32

# Mercado Pago — apuntar a mock/sandbox si aplica
MP_API_BASE_URL=https://api.mercadopago.com
