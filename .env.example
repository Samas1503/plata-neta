# App
DATABASE_URL=postgresql://plata:plata@localhost:5433/plata_neta
APP_ENV=sandbox                          # sandbox | production

# Auth (apps/web)
AUTH_SECRET=                             # openssl rand -base64 32
AUTH_URL=http://localhost:3500

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# MODO / Ualá / Naranja X
MODO_API_KEY=
UALA_API_KEY=
NARANJAX_API_KEY=
# MODO_WEBHOOK_SECRET=
# UALA_WEBHOOK_SECRET=
# NARANJAX_WEBHOOK_SECRET=

# Ripio — scoped keys only: create-intent + read-status, NEVER movement endpoints (RULES.MD §8)
RIPIO_API_KEY=
RIPIO_API_SECRET=
RIPIO_WEBHOOK_SECRET=
# Billeteras/bancos 0% (transferencia CVU/CBU — setear cuando el PSP habilite webhooks)
# BRUBANK_WEBHOOK_SECRET=
# PERSONALPAY_WEBHOOK_SECRET=
# CUENTADNI_WEBHOOK_SECRET=
# PREX_WEBHOOK_SECRET=
# BNAPLUS_WEBHOOK_SECRET=
# GALICIA_WEBHOOK_SECRET=
# SANTANDER_WEBHOOK_SECRET=
# BBVA_WEBHOOK_SECRET=
# MACRO_WEBHOOK_SECRET=
# BNA_WEBHOOK_SECRET=
# PROVINCIA_WEBHOOK_SECRET=
# CREDICOOP_WEBHOOK_SECRET=

# Suscripciones
BILLING_CRON_SECRET=

# Crypto para PspCredential (AES-256-GCM, 32 bytes base64)
ENCRYPTION_KEY=                        # openssl rand -base64 32

# Mercado Pago — apuntar a mock/sandbox si aplica
MP_API_BASE_URL=https://api.mercadopago.com

# Bootstrap para crear la primera API key por tenant (dev only)
BOOTSTRAP_SECRET=
REDIS_URL=redis://localhost:6379

# Payouts — umbral en centavos para aprobación en dos pasos (default 10000000 = $100k ARS)
# PAYOUT_APPROVAL_THRESHOLD=10000000
