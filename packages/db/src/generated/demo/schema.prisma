// plata-neta — schema v0 (Fase 0)
// Reglas: montos en centavos (BigInt), todo recurso de negocio cuelga de tenantId (RULES.MD §1, §3)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/demo"
}

datasource db {
  provider = "sqlite"
  url      = "file:./demo.db"
}

model Tenant {
  id            String              @id @default(cuid())
  name          String
  slug          String              @unique
  status        String              @default("ONBOARDING")
  kycStatus     String              @default("PENDING")
  planId        String?
  plan          Plan?               @relation(fields: [planId], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  users         User[]
  apiKeys       ApiKey[]
  credentials   PspCredential[]
  intents       PaymentIntent[]
  payouts       Payout[]
  ledgerEntries LedgerEntry[]
  cycles        SubscriptionCycle[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  name         String?
  role         String   @default("OPERATOR")
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique // starter | growth | scale | enterprise
  gmvThreshold BigInt // GMV mensual mínimo del tier, en centavos ARS
  monthlyPrice BigInt // precio mensual, en centavos ARS
  tenants      Tenant[]
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  prefix     String // pk_live_ | sk_live_ | pk_test_ | sk_test_
  keyHash    String // sha256 del secret — nunca se guarda en claro
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([tenantId, prefix])
  @@index([keyHash])
}

model PspCredential {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  provider      String // mercadopago | modo | uala | naranjax | ripio
  encryptedKeys String // blob cifrado en reposo (RULES.MD §3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, provider])
}

model PaymentIntent {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  provider       String
  amountCents    BigInt
  currency       String // ARS | USD | USDT | USDC
  status         String    @default("PENDING")
  idempotencyKey String
  externalRef    String? // referencia del PSP (payment_id, txHash, etc.)
  metadata       String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
}

model Payout {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  provider        String
  payeeRef        String // CVU, alias o wallet address del beneficiario
  amountCents     BigInt
  currency        String
  status          String   @default("PENDING")
  idempotencyKey  String
  externalRef     String?
  createdByUserId String? // usuario del dashboard que creó el payout
  approvedById    String? // aprobación en dos pasos sobre umbral (RULES.MD §1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
}

model LedgerEntry {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  account     String // available | pending | fees
  debitCents  BigInt   @default(0)
  creditCents BigInt   @default(0)
  refType     String? // payment_intent | payout | subscription
  refId       String?
  createdAt   DateTime @default(now())

  @@index([tenantId, account])
  @@index([refType, refId])
}

model WebhookEvent {
  id             String    @id @default(cuid())
  provider       String
  eventId        String?
  tenantId       String?
  payload        Json
  signatureValid Boolean   @default(false)
  processedAt    DateTime?
  receivedAt     DateTime  @default(now())

  @@index([provider, eventId])
  @@index([processedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String? // user del dashboard o null si fue via API key
  apiKeyId  String? // key que ejecutó la acción
  action    String // api_key.create | api_key.revoke | payout.create | payout.approve | credential.upsert | plan.change
  entity    String
  entityId  String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
}

model SubscriptionCycle {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  gmvSnapshot BigInt    @default(0) // centavos ARS
  tierApplied String
  amountCents BigInt
  invoicedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([tenantId, periodStart])
}
