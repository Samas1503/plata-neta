    "build": "prisma generate && tsc --noEmit",
    "generate:demo": "prisma generate --schema prisma/schema.demo.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prisma": "^6.9.0",
    "typescript": "^5.7.0"
  }
}